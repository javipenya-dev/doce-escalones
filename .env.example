# ============================================================
# Variables de entorno — copia este fichero a .env y edítalo
# ============================================================

# Base de datos PostgreSQL
DATABASE_URL=postgresql+asyncpg://doce_user:doce_pass@localhost:5432/doce_escalones

# Seguridad JWT — cambia este valor antes de arrancar en producción
# Genera uno nuevo con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_en_produccion_pon_aqui_una_clave_larga

# Tiempo de expiración del token (minutos). 480 = 8 horas
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Puerto del backend (solo necesario fuera de Docker)
PORT=8000
